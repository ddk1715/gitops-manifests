# ==========================================
# Етап 1: Збирання (Builder stage)
# ==========================================
FROM maven:3.9.6-eclipse-temurin-17 AS builder

# Встановлюємо робочу директорію всередині контейнера
WORKDIR /app

# Крок 1: Копіюємо ТІЛЬКИ pom.xml спочатку
COPY pom.xml .

# Крок 2: Завантажуємо залежності в офлайн-режим.
# Оскільки pom.xml змінюється рідко, Docker закешує цей шар.
# Це зекономить студентам купу часу при наступних збираннях, 
# бо Maven не буде качати пів інтернету щоразу.
RUN mvn dependency:go-offline -B

# Крок 3: Копіюємо вихідний код і збираємо проєкт
COPY src ./src
RUN mvn clean package -DskipTests

# ==========================================
# Етап 2: Виконання (Runtime stage)
# ==========================================
# Використовуємо мінімалістичний JRE (на базі Alpine Linux), а не JDK.
# Нам більше не потрібен Maven чи компілятор, лише середовище для виконання.
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# БЕЗПЕКА: Створюємо непривілейованого користувача та групу.
# У Kubernetes (і GitOps зокрема) дуже поганою практикою є запуск контейнерів від root.
RUN addgroup -S springgroup && adduser -S springuser -G springgroup
USER springuser:springgroup

# Копіюємо готовий .jar файл з Етапу 1 (builder)
# Зверніть увагу: ми копіюємо лише ОДИН файл, залишаючи весь сміттєвий кеш Maven позаду.
COPY --from=builder /app/target/*.jar app.jar

# Вказуємо, який порт слухає наш застосунок (документаційний характер)
EXPOSE 8080

# Точка входу — команда запуску Spring Boot застосунку
ENTRYPOINT ["java", "-jar", "app.jar"]
